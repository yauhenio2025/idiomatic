  "example_tl": "A divulgação seletiva de pesquisas minou a confiança pública nas eleições, embora nenhuma evidência sustentasse as acusações repetidas pelos candidatos derrotados.",
  "example_en": "The selective release of polls eroded public confidence in the elections, although no evidence supported the accusations repeated by the defeated candidates.",
  "cloze": "A divulgação seletiva de pesquisas {{c1::minou}} a confiança pública nas eleições, embora nenhuma evidência sustentasse as acusações repetidas pelos candidatos derrotados.",
  "note": "Old_back oferece corroer, alternativa válida no mesmo exemplo. Minar foi escolhido como forma principal por sua colocação frequente com confiança e legitimidade."
}
pt_fancy_vocab_b03_notes
{
  "id": "it_fancy_vocab_085",
  "en": "To overshadow",
  "category": "lexical-verb",
  "tl": "ofuscar",
  "alts": [
    "eclipsar"
  ],
  "register": "Neutro-formal e frequentemente crítico quando um acontecimento ou tema desvia a atenção de outro ou reduz sua importância percebida.",
  "trap": "Sombrear normalmente significa fornecer sombra ou sombreado; no sentido figurado de relegar algo a segundo plano, ofuscar ou eclipsar é mais idiomático.",
  "example_tl": "A controvérsia sobre o vazamento ofuscou as conclusões centrais da auditoria, que apontavam falhas sistêmicas na proteção de dados de milhões de usuários.",
  "example_en": "The controversy over the leak overshadowed the audit's central findings, which identified systemic failures in protecting the data of millions of users.",
  "cloze": "A controvérsia sobre o vazamento {{c1::ofuscou}} as conclusões centrais da auditoria, que apontavam falhas sistêmicas na proteção de dados de milhões de usuários.",
  "note": "Old_back oferece um equivalente adequado. O contexto fixa o sentido informacional de retirar destaque, não os sentidos físicos de bloquear a visão ou emitir brilho. Autorrevisão: substituí um verbo-decoy pouco natural por sombrear."
}
pt_fancy_vocab_b06_notes
{
  "id": "it_fancy_vocab_233",
  "en": "Reductionist",
  "category": "lexical-adjective",
  "tl": "reducionista",
  "alts": [],
  "register": "Formal e geralmente crítico para uma explicação que reduz fenômenos complexos a uma causa, dimensão ou mecanismo exclusivo.",
  "trap": "O português escreve reducionista com um c; o espanhol reduccionista pode induzir a duplicação indevida da consoante.",
  "example_tl": "A leitura reducionista atribui a polarização apenas aos algoritmos e ignora a desigualdade, os incentivos partidários, a concentração midiática e as escolhas editoriais.",
  "example_en": "The reductionist reading attributes polarization solely to algorithms and ignores inequality, partisan incentives, media concentration, and editorial choices.",
  "cloze": "A leitura {{c1::reducionista}} atribui a polarização apenas aos algoritmos e ignora a desigualdade, os incentivos partidários, a concentração midiática e as escolhas editoriais.",
  "note": "Old_back está correto. A retenção combina uma interferência ortográfica concreta com o enquadramento crítico que diferencia reducionista de simplesmente resumido."
