/bin/bash -lc ".venv/bin/python - <<'PY'
import json,re
from pathlib import Path
base=Path('idiomatic/grammar/data/exercises2/batches')
wave=json.loads((base/'manifests/wave4.json').read_text())
pilot=json.loads((base/'manifests/vocab-pilot.json').read_text())
chunks=[Path(x['path']).stem for m in (wave,pilot) for x in m['chunks'] if x['topic']=='fancy_vocab']
manifest={Path(x['path']).stem:set(x.get('expected_duplicate_drop_ids',[])) for x in wave['chunks'] if x['topic']=='fancy_vocab'}
expected_keys={'id','en','category','tl','alts','register','trap','example_tl','example_en','cloze','note'}
expected_cats={'lexical-verb','lexical-noun','lexical-adjective','lexical-adverb','lexical-expression'}
problems=[]; totals={}; allnotes=[]
for c in chunks:
    notes=json.loads((base/'output'/f'{c}_notes.json').read_text())
    tri=json.loads((base/'output'/f'{c}_triage.json').read_text())
    actual_drop={x['id'] for x in tri if x['verdict']=='drop'}
    missing=manifest.get(c,set())-actual_drop
    if missing: problems.append(f'{c} expected duplicate kept: {sorted(missing)}')
    for x in notes:
        if set(x)"'!=expected_keys: problems.append(f"{c}:{x.get('"'id')} keys={sorted(set(x)"'^expected_keys)}")
        if x.get('"'category') not in expected_cats: problems.append(f\"{c}:{x.get('id')} category={x.get('category')}\")
        allnotes.append((c,x))
    totals[c]=(len(tri),sum(x['verdict']=='keep' for x in tri),sum(x['verdict']=='drop' for x in tri))
print('chunks',len(chunks),'triage_rows',sum(v[0] for v in totals.values()),'notes',len(allnotes),'drops',sum(v[2] for v in totals.values()))
print('exact_schema_manifest_problems',len(problems))
for x in problems: print(x)
print('\\nCOUNTS_BY_LANGUAGE')
for lang in ('de','es','fr','it','pt'):
    xs=[v for c,v in totals.items() if c.startswith(lang+'_')]
    print(lang,'chunks',len(xs),'input',sum(v[0] for v in xs),'keep',sum(v[1] for v in xs),'drop',sum(v[2] for v in xs))
# exact/recycled fields and example starters
from collections import defaultdict,Counter
for field in ('tl','register','trap','example_tl','example_en','note'):
    d=defaultdict(list)
    for c,x in allnotes:
        val=x[field].strip()
        if val: d[val].append(f\"{c}:{x['id']}\")
    dup=[(v,ids) for v,ids in d.items() if len(ids)>1]
    print(f'\\nEXACT_DUP_{field}',len(dup),'groups',sum(len(ids) for _,ids in dup),'rows')
    for v,ids in sorted(dup,key=lambda z:(-len(z[1]),z[0]))[:20]:
        print(len(ids),repr(v[:140]),ids[:8])
for n in (3,4,5,6):
    d=defaultdict(list)
    for c,x in allnotes:
        words=re.findall(r\"["'^'"\\W_]+(?:['’\\-]["'^'"\\W_]+)*\",x['example_tl'].lower())
        key=' '.join(words[:n]); d[key].append(f\"{c}:{x['id']}\")
    dup=[(k,v) for k,v in d.items() if len(v)>=3]
    print(f'\\nSTART_{n}_WORDS repeated>=3:',len(dup))
    for k,v in sorted(dup,key=lambda z:(-len(z[1]),z[0]))[:30]: print(len(v),repr(k),v[:10])
# duplicate registry relevant groups
report=json.loads(Path('docs/research/legacy_estate/exercises2_cross_topic_exact_duplicates.json').read_text())
print('\\nDUP_REPORT_TYPE',type(report).__name__)
print(json.dumps(report if isinstance(report,list) else {k:(len(v) if isinstance(v,list) else v) for k,v in report.items()},ensure_ascii=False,indent=2)[:4000])
