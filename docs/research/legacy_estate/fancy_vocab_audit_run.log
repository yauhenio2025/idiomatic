}
fr_fancy_vocab_b07_notes
{
  "id": "it_fancy_vocab_252",
  "en": "the Regulations",
  "category": "lexical-noun",
  "tl": "la réglementation",
  "alts": [],
  "register": "Formal institutional term for the collective body of rules governing an activity; les règlements instead identifies discrete rules or legal instruments.",
  "trap": "English plural regulations often maps to collective singular réglementation; French régulation usually foregrounds regulatory action or a sectoral governance mechanism.",
  "example_tl": "La réglementation des plateformes devrait garantir l’accès des chercheurs aux données, sans permettre aux entreprises de choisir seules les questions jugées légitimes.",
  "example_en": "Platform regulations should guarantee researchers access to data without allowing companies alone to decide which questions are considered legitimate.",
  "cloze": "{{c1::La réglementation}} des plateformes devrait garantir l’accès des chercheurs aux données, sans permettre aux entreprises de choisir seules les questions jugées légitimes.",
  "note": "Materially refines old_back les réglementations by selecting the idiomatic collective singular for the regulatory framework demonstrated in the example."
}
fr_fancy_vocab_b10_notes
{
  "id": "it_fancy_vocab_377",
  "en": "the Regulation",
  "category": "lexical-noun",
  "tl": "la réglementation",
  "alts": [],
  "register": "Neutral-formal policy noun for a body or framework of binding rules; common in legal and regulatory analysis.",
  "trap": "Un règlement is a particular rule or legal instrument, while régulation often foregrounds the process of steering a sector rather than the rules themselves.",
  "example_tl": "La réglementation sur les services numériques impose des obligations particulières aux grandes plateformes, sans interdire pour autant tous les modèles publicitaires ciblés.",
  "example_en": "Digital-services regulation imposes specific obligations on large platforms without, however, banning every targeted-advertising model.",
  "cloze": "{{c1::La réglementation}} sur les services numériques impose des obligations particulières aux grandes plateformes, sans interdire pour autant tous les modèles publicitaires ciblés.",
  "note": "Materially replaces old_back le règlement, which selects an individual instrument rather than the regulatory framework demonstrated here."
}
