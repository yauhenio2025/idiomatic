  "note": "The old gloss is exact; self-review kept the ordinary adjective and clarified that persuasion does not equal proof."
}
de_fancy_vocab_b15_notes
{
  "id": "it_fancy_vocab_571",
  "en": "Persuasive",
  "category": "lexical-adjective",
  "tl": "überzeugend",
  "alts": [],
  "register": "Neutral-formal argumentative and journalistic usage for reasoning or presentation that successfully wins agreement without necessarily proving the claim.",
