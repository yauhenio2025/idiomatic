  {"id": "it_fancy_vocab_007", "en": "To privatize", "verdict": "drop", "reason": "Privatisieren is a transparent, high-frequency policy cognate with no distinct production trap in this prompt."},
  {"id": "it_fancy_vocab_008", "en": "To innovate", "verdict": "keep", "reason": "German normally uses Innovationen hervorbringen or Neues entwickeln; the legacy erneuern instead means renew or modernize something."},
  {"id": "it_fancy_vocab_009", "en": "To integrate", "verdict": "drop", "reason": "Integrieren is a transparent cognate, while the isolated source does not choose a transitive, reflexive or social-integration frame."},
  {"id": "it_fancy_vocab_010", "en": "To disrupt", "verdict": "keep", "reason": "The structural industry-change sense requires a stronger nonliteral rendering than the legacy stören, which usually names interruption or impairment."},
