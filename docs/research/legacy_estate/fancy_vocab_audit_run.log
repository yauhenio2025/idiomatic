{
  "id": "it_fancy_vocab_473",
  "en": "To postulate",
  "category": "lexical-verb",
  "tl": "etwas postulieren",
  "alts": [
    "etwas als gegeben annehmen",
    "etwas voraussetzen"
  ],
  "register": "Formal academic and theoretical usage for proposing a premise or explanatory claim as a basis for reasoning.",
  "trap": "Postulieren is a legitimate German academic loanword, but it does not mean prove; the proposition remains a premise or hypothesis.",
  "example_tl": "Die Studie postuliert, dass automatisierte Rankings bestehende soziale Vorurteile verstärken, selbst wenn ihre Entwickler keine politische Absicht verfolgen.",
  "example_en": "The study postulates that automated rankings reinforce existing social prejudices even when their developers have no political intention.",
  "cloze": "Die Studie {{c1::postuliert}}, dass automatisierte Rankings bestehende soziale Vorurteile verstärken, selbst wenn ihre Entwickler keine politische Absicht verfolgen.",
  "note": "The old gloss Postulieren is usable but leaves the register implicit; self-review confirms the academic premise-setting sense and adds the dass-clause pattern."
}
de_fancy_vocab_b13_notes
{
  "id": "it_fancy_vocab_492",
  "en": "The contention",
  "category": "lexical-noun",
  "tl": "die These",
  "alts": [
    "die Behauptung"
  ],
  "register": "Formal argumentative usage for a claim or position advanced in a dispute, paper or public controversy.",
  "trap": "Contention foregrounds a claim that is open to dispute; These is more structured than Behauptung, while Streit is the conflict itself.",
  "example_tl": "Die strittige These der Studie, Sanktionen würden die Regierung rasch zum Einlenken bewegen, unterschätzt deren Fähigkeit zur wirtschaftlichen Anpassung.",
  "example_en": "The study's contentious thesis that sanctions would quickly bring the government to the negotiating table underestimates its capacity for economic adaptation.",
  "cloze": "Die strittige {{c1::These}} der Studie, Sanktionen würden die Regierung rasch zum Einlenken bewegen, unterschätzt deren Fähigkeit zur wirtschaftlichen Anpassung.",
  "note": "The old gloss Die Behauptung is usable but misses the organized argumentative position; self-review retained this card as distinct from assertion."
}
de_fancy_vocab_b13_notes
{
  "id": "it_fancy_vocab_496",
  "en": "The elucidation",
  "category": "lexical-noun",
  "tl": "die Erläuterung",
  "alts": [
    "die Erklärung",
    "die Klarstellung"
  ],
  "register": "Formal academic and professional usage for a clarifying explanation of a difficult point or mechanism.",
  "trap": "Erläuterung adds clarification and detail; Aufklärung can mean investigation or enlightenment and is not an automatic substitute.",
  "example_tl": "Die Erläuterung des Gutachtens machte nachvollziehbar, warum die scheinbar neutrale Kennzahl bestimmte Regionen systematisch bei der Mittelvergabe benachteiligte.",
  "example_en": "The elucidation in the expert report made it understandable why the seemingly neutral metric systematically disadvantaged certain regions in funding allocation.",
  "cloze": "Die {{c1::Erläuterung}} des Gutachtens machte nachvollziehbar, warum die scheinbar neutrale Kennzahl bestimmte Regionen systematisch bei der Mittelvergabe benachteiligte.",
  "note": "The old gloss Die Erläuterung is correct; self-review selected a technical explanation context and explicitly rejected the misleading investigative sense of Aufklärung."
}
