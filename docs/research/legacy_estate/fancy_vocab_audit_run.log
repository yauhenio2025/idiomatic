import json,re
from pathlib import Path
base=Path('idiomatic/grammar/data/exercises2/batches/output')
paths=sorted(base.glob('*_fancy_vocab_b*_notes.json'))+sorted(base.glob('*_fancy_vocab_pilot_b*_notes.json'))
leaks=[]; empty=[]; many=[]; punct=[]
for p in paths:
 for x in json.loads(p.read_text()):
  groups=re.findall(r'\\{\\{c1::(.*?)\\}\\}',x['cloze'])
  if not groups: empty.append((p.stem,x['id']))
  if len(groups)>2: many.append((p.stem,x['id'],groups,x['tl']))
  plain=re.sub(r'\\{\\{c1::.*?\\}\\}','',x['cloze']).casefold()
  for g in groups:
   if len(g)>=3 and g.casefold() in plain:
    leaks.append((p.stem,x['id'],x['tl'],g,x['cloze']))
   if g and not re.search(r'\\w',g,re.UNICODE): punct.append((p.stem,x['id'],g))
print('no_groups',len(empty));print(*empty,sep='\\n')
print('more_than_2_groups',len(many));print(*many,sep='\\n')
print('exact_payload_leaks',len(leaks));print(*leaks,sep='\\n')
print('punct_only',len(punct));print(*punct,sep='\\n')
