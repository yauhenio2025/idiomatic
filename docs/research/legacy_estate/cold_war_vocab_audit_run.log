import json, subprocess
from pathlib import Path
root = Path('idiomatic/grammar/data/exercises2/batches/output')
for path in sorted(root.glob('*_cold_war_vocab_b*_*.json')):
    rel = str(path)
    try:
        old = json.loads(subprocess.check_output(['git','show',f'HEAD:{rel}']))
    except subprocess.CalledProcessError:
        continue
    new = json.loads(path.read_text())
    old_by = {x['id']: x for x in old}
    changes=[]
    for n in new:
        o=old_by[n['id']]
        fields=[k for k in n if o.get(k)"'!=n.get(k)]
        if fields: changes.append((n['"'id'],fields))
    if changes:
        print(path.name, 'rows='+str(len(changes)), 'fields='+str(sum(len(x[1]) for x in changes)))
        for i,fs in changes: print(' ',i,','.join(fs))
