+    },
+    {
+      "id": "pgg-c02-e04-i6",
+      "solution_en": "the green glasses; a pair of green glasses",
+      "why_en": "Accusative: the requested item is the direct object; a feminine adjective takes -e after either article (§§2.2, 6.1)."
+    },
+    {
+      "id": "pgg-c02-e04-i7",
+      "solution_en": "the striped dress; a striped dress",
+      "why_en": "Accusative: the requested item is the direct object; a neuter adjective takes -e after the definite article and -es after the indefinite (§§2.2, 6.1)."
+    },
+    {
+      "id": "pgg-c02-e04-i8",
+      "solution_en": "the black winter coat; a black winter coat",
+      "why_en": "Accusative: the requested item is the direct object; a masculine adjective takes -en after either article (§§2.2, 6.1)."
+    },
+    {
+      "id": "pgg-c02-e04-i9",
+      "solution_en": "the red roses; red roses",
+      "why_en": "Accusative: the requested items are direct objects; a plural adjective takes -en after the definite article and -e without one (§§2.2, 6.1)."
+    },
+    {
+      "id": "pgg-c02-e04-i10",
+      "solution_en": "the ripe avocado; a ripe avocado",
+      "why_en": "Accusative: the requested item is the direct object; a feminine adjective takes -e after either article (§§2.2, 6.1)."
+    },
+    {
+      "id": "pgg-c02-e04-i11",
+      "solution_en": "the plain writing paper; some plain writing paper",
+      "why_en": "Accusative: the requested item is the direct object; a neuter adjective takes -e after the definite article and -es after the indefinite (§§2.2, 6.1)."
+    },
+    {
+      "id": "pgg-c02-e04-i12",
+      "solution_en": "the affordable laptop; an affordable laptop",
+      "why_en": "Accusative: the requested item is the direct object; a masculine adjective takes -en after either article (§§2.2, 6.1)."
+    },
+    {
+      "id": "pgg-c02-e04-i13",
+      "solution_en": "the large dictionary; a large dictionary",
+      "why_en": "Accusative: the requested item is the direct object; a neuter adjective takes -e after the definite article and -es after the indefinite (§§2.2, 6.1)."
+    },
+    {
+      "id": "pgg-c02-e04-i14",
+      "solution_en": "the blue felt-tip pen; a blue felt-tip pen",
+      "why_en": "Accusative: the requested item is the direct object; a masculine adjective takes -en after either article (§§2.2, 6.1)."
+    },
+    {
+      "id": "pgg-c02-e04-i15",
+      "solution_en": "the new telephone; a new telephone",
+      "why_en": "Accusative: the requested item is the direct object; a neuter adjective takes -e after the definite article and -es after the indefinite (§§2.2, 6.1)."
+    },
+    {
+      "id": "pgg-c02-e04-i16",
+      "solution_en": "the challenging novel; a challenging novel",
+      "why_en": "Accusative: the requested item is the direct object; a masculine adjective takes -en after either article (§§2.2, 6.1)."
+    },
+    {
+      "id": "pgg-c02-e04-i17",
+      "solution_en": "the comfortable armchairs; comfortable armchairs",
+      "why_en": "Accusative: the requested items are direct objects; a plural adjective takes -en after the definite article and -e without one (§§2.2, 6.1)."
+    },
+    {
+      "id": "pgg-c02-e04-i18",
+      "solution_en": "the electric razor; an electric razor",
+      "why_en": "Accusative: the requested item is the direct object; a masculine adjective takes -en after either article (§§2.2, 6.1)."
+    },
+    {
+      "id": "pgg-c02-e04-i19",
+      "solution_en": "the patterned tights; patterned tights",
+      "why_en": "Accusative: the requested items are direct objects; a plural adjective takes -en after the definite article and -e without one (§§2.2, 6.1)."
+    },
+    {
+      "id": "pgg-c02-e04-i20",
+      "solution_en": "the juicy oranges; juicy oranges",
+      "why_en": "Accusative: the requested items are direct objects; a plural adjective takes -en after the definite article and -e without one (§§2.2, 6.1)."
+    },
+    {
+      "id": "pgg-c02-e04-i21",
+      "solution_en": "the large room; a large room",
+      "why_en": "Accusative: the requested item is the direct object; a neuter adjective takes -e after the definite article and -es after the indefinite (§§2.2, 6.1)."
+    },
+    {
+      "id": "pgg-c02-e04-i22",
+      "solution_en": "the gray scarf; a gray scarf",
+      "why_en": "Accusative: the requested item is the direct object; a masculine adjective takes -en after either article (§§2.2, 6.1)."
+    },
+    {
+      "id": "pgg-c02-e05-i1",
+      "solution_en": "They had to walk the long way.",
+      "why_en": "Accusative: a bare noun phrase with a motion verb marks the distance travelled (§2.2.2)."
+    },
+    {
+      "id": "pgg-c02-e05-i2",
+      "solution_en": "Everyone at the office got along well, but after work each person went their separate way again.",
+      "why_en": "Genitive: the route is expressed by a fixed adverbial phrase meaning to go one's way (§2.3.3)."
+    },
+    {
+      "id": "pgg-c02-e05-i3",
+      "solution_en": "I still haven't seen him at all today.",
+      "why_en": "Accusative: a bare adverbial time phrase marks the full duration (§2.2.2)."
+    },
+    {
+      "id": "pgg-c02-e05-i5",
+      "solution_en": "We were on vacation for almost the whole of August last year.",
+      "why_en": "Accusative: bare time phrases mark a specific period and a complete duration; the year phrase omits its article (§2.2.2)."
+    },
+    {
+      "id": "pgg-c02-e05-i6",
+      "solution_en": "One day, I hope to travel all the way down the Rhine.",
+      "why_en": "Genitive marks an indefinite day; accusative with the motion verb marks the distance travelled (§§2.3.3, 2.2.2)."
+    },
+    {
+      "id": "pgg-c02-e05-i7",
+      "solution_en": "He has already been skiing four times this winter.",
+      "why_en": "Accusative: a bare time phrase identifies a specific period (§2.2.2)."
+    },
+    {
+      "id": "pgg-c02-e05-i8",
+      "solution_en": "One evening, as he was just going down the stairs, the doorbell suddenly rang.",
+      "why_en": "Genitive marks an indefinite evening; accusative with the direction verb marks the path travelled (§§2.3.3, 2.2.2)."
+    },
+    {
+      "id": "pgg-c02-e05-i9",
+      "solution_en": "Cut the dough into slices one centimeter thick and chill them for a moment.",
+      "why_en": "Accusative: the first bare phrase measures thickness and the second measures duration (§2.2.2)."
+    },
+    {
+      "id": "pgg-c02-e05-i10",
+      "solution_en": "A spider is crawling up your arm right now.",
+      "why_en": "Accusative: the bare noun phrase with a direction adverb marks the path travelled (§2.2.2)."
+    },
+    {
+      "id": "pgg-c02-e05-i11",
+      "solution_en": "After he had waited almost a month for the package, it finally arrived one fine morning.",
+      "why_en": "Accusative marks duration; genitive marks an indefinite morning in a set time expression (§§2.2.2, 2.3.3)."
+    },
+    {
+      "id": "pgg-c02-e12-i1",
+      "solution_en": "Tobias looks like his brother.",
+      "why_en": "Dative: an adjective expressing similarity takes the person used for comparison as its complement (§2.5.4)."
+    },
+    {
+      "id": "pgg-c02-e12-i2",
+      "solution_en": "The boy is too cold in the water.",
+      "why_en": "Dative: an impersonal sensation construction marks the experiencer in the dative (§2.5.4)."
+    },
+    {
+      "id": "pgg-c02-e12-i3",
+      "solution_en": "The red dress fits the young woman very well.",
+      "why_en": "Dative: the person concerned or affected by how something fits is marked in the dative (§2.5)."
+    },
+    {
+      "id": "pgg-c02-e12-i4",
+      "solution_en": "The woman washes her hands.",
+      "why_en": "Dative: a reflexive possessor precedes the body part, which takes the definite article (§2.5.3)."
+    },
+    {
+      "id": "pgg-c02-e12-i5",
+      "solution_en": "You put on the green sweater.",
+      "why_en": "Dative: the subject's reflexive pronoun marks possession of the article of clothing (§2.5.3)."
+    },
+    {
+      "id": "pgg-c02-e12-i6",
+      "solution_en": "Maditha cut her finger.",
+      "why_en": "Dative: a body part used with a preposition requires the subject's reflexive possessor (§2.5.3)."
+    },
+    {
+      "id": "pgg-c02-e12-i7",
+      "solution_en": "Niklas broke his leg.",
+      "why_en": "Dative: the subject's reflexive pronoun marks possession of the affected body part (§2.5.3)."
+    },
+    {
+      "id": "pgg-c02-e12-i8",
+      "solution_en": "This perfume was much too expensive for her acquaintance.",
+      "why_en": "Dative: with an adjective qualified by 'too,' the person whose standpoint is expressed precedes the adjective (§2.5.4)."
+    },
+    {
+      "id": "pgg-c02-e12-i9",
+      "solution_en": "I poured my colleague some more wine.",
+      "why_en": "Dative: the recipient is the indirect object, alongside the direct object denoting what is poured (§2.5.1)."
+    },
+    {
+      "id": "pgg-c02-e12-i10",
+      "solution_en": "Then my father's house key fell through the grate.",
+      "why_en": "Dative: the father is the person adversely affected when the key falls through the grate (§2.5.2)."
+    },
+    {
+      "id": "pgg-c02-e12-i11",
+      "solution_en": "Roe deer crossed the hiker's path.",
+      "why_en": "Dative: the hiker is the person affected by the deer crossing his path (§2.5.2)."
+    },
+    {
+      "id": "pgg-c02-e12-i12",
+      "solution_en": "This skirt wasn't long enough for my sister.",
+      "why_en": "Dative: with an adjective qualified by 'enough,' the person whose standpoint is expressed precedes the adjective (§2.5.4)."
+    },
+    {
+      "id": "pgg-c02-e12-i13",
+      "solution_en": "Andreas brought his girlfriend a piece of cake.",
+      "why_en": "Dative: the recipient is the indirect object, alongside the direct object denoting what is brought (§2.5.1)."
+    },
+    {
+      "id": "pgg-c02-e12-i14",
+      "solution_en": "Time passed much too slowly for the children.",
+      "why_en": "Dative: the children supply the standpoint from which the rate of an event is judged (§2.5.2)."
+    },
+    {
+      "id": "pgg-c02-e12-i15",
+      "solution_en": "The child's stomach hurt.",
+      "why_en": "Dative: the affected child is the possessor of the body part and is not the sentence's subject (§2.5.3)."
+    },
+    {
+      "id": "pgg-c02-e12-i16",
+      "solution_en": "The mother put the trousers on her daughter.",
+      "why_en": "Dative: the daughter is the possessor of the clothing and is not the sentence's subject (§2.5.3)."
+    },
+    {
+      "id": "pgg-c02-e12-i17",
+      "solution_en": "The fat man wiped the sweat from his forehead.",
+      "why_en": "Dative: a reflexive possessor precedes the body part, which takes the definite article (§2.5.3)."
+    },
+    {
+      "id": "pgg-c02-e10-i1",
+      "solution_en": "The car is too expensive for my sister.",
+      "why_en": "Dative: the person whose standpoint is expressed precedes an adjective qualified by 'too' (§2.5.2)."
+    },
+    {
+      "id": "pgg-c02-e10-i2",
+      "solution_en": "You'll surely watch the film.",
+      "why_en": "Dative: the reflexive benefactive marks the person for whose own benefit the action is done (§2.5.2)."
+    },
+    {
+      "id": "pgg-c02-e10-i3",
+      "solution_en": "The plate fell from her hand.",
+      "why_en": "Dative: the person is adversely affected by the plate falling from her possession (§2.5.2)."
+    },
+    {
+      "id": "pgg-c02-e10-i4",
+      "solution_en": "England is too cold for him.",
+      "why_en": "Dative: the person whose standpoint is expressed precedes an adjective qualified by 'too' (§2.5.2)."
+    },
+    {
+      "id": "pgg-c02-e10-i5",
+      "solution_en": "She wrote down his address for me.",
+      "why_en": "Dative: the benefactive marks the person on whose behalf the action is done (§2.5.2)."
+    },
+    {
+      "id": "pgg-c02-e10-i6",
+      "solution_en": "It was an honor for us to spend the evening with you.",
+      "why_en": "Dative: with a copular verb and noun, the person concerned is marked in the dative (§2.5.2)."
+    },
+    {
+      "id": "pgg-c02-e10-i7",
+      "solution_en": "Children eat you out of house and home.",
+      "why_en": "Dative: the person is disadvantaged by the undesirable effect of the action (§2.5.2)."
+    },
+    {
+      "id": "pgg-c02-e10-i8",
+      "solution_en": "The girl wrecks the boy's sandcastle.",
+      "why_en": "Dative: the boy is disadvantaged by an action affecting his possession (§2.5.2)."
+    },
+    {
+      "id": "pgg-c02-e09-i1",
+      "solution_en": "the effect of some alcohol",
+      "why_en": "The prepositional construction is usual because the dependent noun follows an uninflected quantity word (§2.4.1)."
+    },
+    {
+      "id": "pgg-c02-e09-i2",
+      "solution_en": "my father's car",
+      "why_en": "Genitive: a dependent noun phrase expresses possession, and written German normally prefers this construction (§2.4)."
+    },
+    {
+      "id": "pgg-c02-e09-i5",
+      "solution_en": "the smell of coffee",
+      "why_en": "The prepositional construction is usual when the dependent noun stands alone without a determiner (§2.4.1)."
+    },
+    {
+      "id": "pgg-c02-e09-i6",
+      "solution_en": "the summit of the Matterhorn",
+      "why_en": "Genitive: the dependent noun phrase identifies the summit, and the written norm prefers genitive outside listed exceptions (§2.4)."
+    },
+    {
+      "id": "pgg-c02-e09-i8",
+      "solution_en": "the opinion of many Germans",
+      "why_en": "Genitive: with a noun qualified by an indefinite pronoun, either genitive or a prepositional phrase is acceptable (§2.4.2)."
+    },
+    {
+      "id": "pgg-c02-e09-i10",
+      "solution_en": "some of her balance",
+      "why_en": "The prepositional construction is required in a partitive headed by an indefinite pronoun (§2.4.1)."
+    },
+    {
+      "id": "pgg-c02-e09-i11",
+      "solution_en": "the end of next week",
+      "why_en": "Genitive: the dependent time phrase identifies which week's end, following the written norm (§2.4)."
+    },
+    {
+      "id": "pgg-c02-e09-i14",
+      "solution_en": "the improvement of my English skills",
+      "why_en": "Genitive: a fully inflected dependent noun phrase normally uses the genitive in writing (§2.4)."
+    },
+    {
+      "id": "pgg-c02-e09-i15",
+      "solution_en": "none of my balance",
+      "why_en": "The prepositional construction is required in a partitive headed by an indefinite pronoun (§2.4.1)."
+    },
+    {
+      "id": "pgg-c02-e09-i17",
+      "solution_en": "which of your teachers",
+      "why_en": "The prepositional construction is required in a partitive headed by an indefinite pronoun (§2.4.1)."
+    },
+    {
+      "id": "pgg-c02-e14-i1",
+      "solution_en": "We spoke with Maria Simon, the German film actress.",
+      "why_en": "Dative: the explanatory apposition matches the case imposed on the name by the preposition (§2.6)."
+    },
+    {
+      "id": "pgg-c02-e14-i2",
+      "solution_en": "My sister is a head taller than my brother.",
+      "why_en": "Nominative: the comparative apposition matches the case of the subject it is compared with (§2.6)."
+    },
+    {
+      "id": "pgg-c02-e14-i3",
+      "solution_en": "A statement by Özdemir, the chair of the Greens, is expected this evening.",
+      "why_en": "Dative: the explanatory apposition matches the case imposed on the name by the preposition (§2.6)."
+    },
+    {
+      "id": "pgg-c02-e14-i4",
+      "solution_en": "On a day like today, I would especially like to thank one man: Mr Grotewohl, the director of our company.",
+      "why_en": "Dative: both the comparative and explanatory appositions match the dative phrases they describe (§2.6)."
+    },
+    {
+      "id": "pgg-c02-e14-i5",
+      "solution_en": "The meeting had to be postponed until the next day, October 25.",
+      "why_en": "Accusative: the date is an apposition and matches the case of the day it identifies (§2.6)."
+    },
+    {
+      "id": "pgg-c02-e14-i6",
+      "solution_en": "The poet was born in 1980 in Neunkirchen an der Saar, the second-largest city in Saarland.",
+      "why_en": "Dative: the explanatory apposition matches the case imposed on the place by the location preposition (§2.6)."
+    },
+    {
+      "id": "pgg-c02-e14-i7",
+      "solution_en": "I would not want to be married to a man like yours.",
+      "why_en": "Dative: the comparative apposition matches the case of the noun phrase it qualifies (§2.6)."
+    },
+    {
+      "id": "pgg-c02-e14-i8",
+      "solution_en": "Yesterday I saw Martin Liebert, a Bavarian cabaret performer, in the restaurant.",
+      "why_en": "Accusative: the explanatory apposition matches the case of the direct-object name (§2.6)."
+    },
+    {
+      "id": "pgg-c02-e14-i10",
+      "solution_en": "For you as the local mayor, speaking to him as the most senior supervisory-board member must be easy. For me as an ordinary citizen, it is much harder.",
+      "why_en": "The comparative appositions match their pronouns: accusative after 'for,' dative after 'with,' then accusative (§2.6)."
+    },
+    {
+      "id": "pgg-c02-e17-i1",
+      "solution_en": "six bottles of German wine (the genitive form sounds old-fashioned)",
+      "why_en": "Accusative: the following noun phrase is appositional and matches the measurement phrase; singular genitive is formal (§2.7.1)."
+    },
+    {
+      "id": "pgg-c02-e17-i2",
+      "solution_en": "two hundred tonnes of Russian iron ore",
+      "why_en": "Dative: the following singular noun phrase is appositional and matches the measurement phrase (§2.7.1)."
+    },
+    {
+      "id": "pgg-c02-e17-i6",
+      "solution_en": "the price of three kilos of French apples",
+      "why_en": "Dative: after the preposition, the plural noun phrase is appositional and matches the measurement phrase (§2.7.1)."
+    },
+    {
+      "id": "pgg-c02-e17-i9",
+      "solution_en": "with a kind of Italian salad",
+      "why_en": "Dative: the following noun phrase is appositional and matches the vague-quantity phrase (§2.7.2)."
+    },
+    {
+      "id": "pgg-c02-e17-i10",
+      "solution_en": "two pounds of good coffee",
+      "why_en": "Accusative: the following noun phrase is appositional and matches the direct-object measurement phrase (§2.7.1)."
+    },
+    {
+      "id": "pgg-c02-e17-i11",
+      "solution_en": "I need half a liter of fresh milk.",
+      "why_en": "Accusative: the following noun phrase is appositional and matches the direct-object measurement phrase (§2.7.1)."
+    }
+  ]
+}

apply patch
patch: completed
