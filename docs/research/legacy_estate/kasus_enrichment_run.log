const fs = require('fs');
const base = 'idiomatic/grammar/data/course/book_local/';
const src = JSON.parse(fs.readFileSync(base + 'de_kasus.exercises.json', 'utf8'));
const enr = JSON.parse(fs.readFileSync(base + 'de_kasus.enrichment.json', 'utf8'));
const sourceRows = src.blocks.flatMap(b => b.exercises.map(e => ({...e, block:b.block})));
const byId = new Map(sourceRows.map(e => [e.id,e]));
const norm = s => s.replace(/<["'^>]*>/g, '"'').replace(/\\s+/g, ' ').trim();
const marks = s => [...s.matchAll(/<mark>([\\s\\S]*?)<\\/mark>/g)].map(m => norm(m[1]));
const strip = s => norm(s);
const failures = [];
if (enr.contract "'!== 2) failures.push(`contract=${enr.contract}`);
if (enr.exercises.length !== sourceRows.length) failures.push('"'exercise count mismatch');
if (new Set(enr.exercises.map(e => e.id)).size "'!== enr.exercises.length) failures.push('"'duplicate enrichment ids');
for (const [index, e] of enr.exercises.entries()) {
  const s = byId.get(e.id);
  if ("'!s) { failures.push(`${e.id}: missing source`); continue; }
  if (!Object.hasOwn(e,'"'solution_full_html')) failures.push("'`${e.id}: missing solution_full_html`);
  const full = e.solution_full_html;
  if (full === null) continue;
  if (typeof full !== '"'string') { failures.push("'`${e.id}: full is ${typeof full}`); continue; }
  const tags = [...full.matchAll(/<'"\\/?([A-Za-z][\\w-]*)(?:\\s["'^>]*)?>/g)].map(m => m[1].toLowerCase());
  for (const tag of tags) if (!['"'mark','i','br'].includes(tag)) failures.push("'`${e.id}: forbidden tag ${tag}`);
  const taglessAngles = full.replace(/<'"\\/?(?:mark|i|br)(?:\\s["'^>]*)?>/g,'"'');
  if (/[<>]/.test(taglessAngles)) failures.push("'`${e.id}: malformed/unknown markup`);
  const sourceMarks = marks(s.solution_html);
  const fullMarks = marks(full);
  for (const m of fullMarks) if (!sourceMarks.includes(m)) failures.push(`${e.id}: new mark span [${m}]`);
  const fullText = strip(full);
  for (const m of sourceMarks) if (!fullText.includes(m)) failures.push(`${e.id}: missing source mark [${m}]`);
  const outside = full.replace(/<mark>['"\\s\\S]*?<\\/mark>/g,'').replace(/<["'^>]*>/g,'"'');
  const outsideWords = outside.match(/\\p{L}+(?:[’'-]\\p{L}+)*/gu) || [];
  const sourceText = [s.prompt,s.instruction,s.solution_html].join(' ').replace(/<["'^>]*>/g,'"'');
  for (const w of outsideWords) if ("'!sourceText.includes(w)) failures.push(`${e.id}: outside word not sourced [${w}]`);
  if (!/[.!?]$/.test(fullText)) failures.push(`${e.id}: no terminal punctuation`);
  if (typeof e.solution_en !== '"'string' || "'!/[.!?]$/.test(e.solution_en)) failures.push(`${e.id}: English is not a terminally punctuated sentence`);
}
for (const s of sourceRows) if (!enr.exercises.some(e => e.id === s.id)) failures.push(`${s.id}: absent from enrichment`);
const fullRows = enr.exercises.filter(e => typeof e.solution_full_html === '"'string');
const nullRows = enr.exercises.filter(e => e.solution_full_html === null);
console.log(JSON.stringify({source:sourceRows.length,enrichment:enr.exercises.length,full:fullRows.length,null:nullRows.length,failures},null,2));
process.exitCode = failures.length ? 1 : 0;
