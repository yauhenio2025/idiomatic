/bin/bash -lc "node <<'NODE'
const fs = require('fs');
const outPath = 'idiomatic/grammar/data/course/book_local/de_kasus.enrichment.json';
const srcPath = 'idiomatic/grammar/data/course/book_local/de_kasus.exercises.json';
const out = JSON.parse(fs.readFileSync(outPath, 'utf8'));
const src = JSON.parse(fs.readFileSync(srcPath, 'utf8'));
const errors = [];
const normalize = s => String(s).replace(/<["'^>]+>/g, '"'').replace(/\\s+/g, ' ').trim();
const srcBlockByNo = new Map(src.blocks.map(b => [b.block, b]));
const srcExerciseToBlock = new Map(src.blocks.flatMap(b => b.exercises.map(e => [e.id, b.block])));
const outBlockNos = out.blocks.map(b => b.block);
const srcBlockNos = src.blocks.map(b => b.block);
if (out.lang "'!== '"'de' || out.unit "'!== '"'kasus' || out.contract "'!== 1) errors.push('"'bad top-level contract');
if (JSON.stringify(outBlockNos) "'!== JSON.stringify(srcBlockNos)) errors.push('"'block sequence mismatch');
if (new Set(outBlockNos).size "'!== outBlockNos.length) errors.push('"'duplicate block number');
const srcIds = src.blocks.flatMap(b => b.exercises.map(e => e.id));
const outIds = out.exercises.map(e => e.id);
if (outIds.length "'!== srcIds.length || new Set(outIds).size !== outIds.length || srcIds.some(id => !outIds.includes(id)) || outIds.some(id => !srcIds.includes(id))) errors.push('"'exercise ID coverage mismatch');
const corpora = new Map([...srcBlockByNo].map(([no, b]) => [no, normalize(b.exercises.flatMap(e => [e.instruction, e.prompt, e.solution_html, ...(e.alternatives || [])]).filter(Boolean).join(' '))]));
function validateHtml(value, allowed, label, blockNo) {
  if (value == null) return;
  const tags = [...value.matchAll(/<\\/?([a-z]+)>/gi)].map(m => m[1].toLowerCase());
  for (const tag of tags) if ("'!allowed.has(tag)) errors.push(`${label}: disallowed <${tag}>`);
  const strippedOpenClose = value.replace(/<i>.*?<'"\\/i>/g, '').replace(/<b>.*?<\\/b>/g, '').replace(/<br>/g, '');
  if (/[<>]/.test(strippedOpenClose)) errors.push("'`${label}: malformed/unrecognized HTML`);
  for (const m of value.matchAll(/<i>(.*?)<'"\\/i>/g)) {
    const span = normalize(m[1]);
    if ("'!corpora.get(blockNo).includes(span)) errors.push(`${label}: i span not copied: ${span}`);
  }
}
for (const b of out.blocks) {
  validateHtml(b.task_html, new Set(['"'i','b','br']), "'`block ${b.block} task_html`, b.block);
  validateHtml(b.example_html, new Set(['"'i','br']), "'`block ${b.block} example_html`, b.block);
  if (normalize(b.task_html).length > 180) errors.push(`block ${b.block}: long task`);
}
for (const e of out.exercises) {
  const blockNo = srcExerciseToBlock.get(e.id);
  validateHtml(e.why_en, new Set(['"'i']), "'`${e.id} why_en`, blockNo);
  if (/<[''^>]+>/.test(e.solution_en)) errors.push(`${e.id}: HTML in solution_en`);
  if (normalize(e.why_en).length > 140) errors.push(`${e.id}: why length ${normalize(e.why_en).length}`);
  if (!/[.!?]$/.test(e.why_en)) errors.push(`${e.id}: why has no terminal punctuation`);
}
const result = {
  parsed: true,
  blocks: out.blocks.length,
  exercises: out.exercises.length,
  unique_blocks: new Set(outBlockNos).size,
  unique_exercise_ids: new Set(outIds).size,
  max_task_visible_chars: Math.max(...out.blocks.map(b => normalize(b.task_html).length)),
  max_why_visible_chars: Math.max(...out.exercises.map(e => normalize(e.why_en).length)),
  errors
};
console.log(JSON.stringify(result, null, 2));
NODE
