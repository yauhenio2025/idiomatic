/home/admin/projects/idiomatic/idiomatic/grammar/data/course/book_local/de_kasus.enrichment.json:195:      "solution_full_html": "Wir waren <mark>letztes Jahr</mark> fast <mark>den ganzen August</mark> im Urlaub.",
