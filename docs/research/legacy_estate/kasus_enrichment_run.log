+    },
+    {
+      "block": 6,
+      "task_html": "Build an idiomatic sentence in an appropriate tense. Insert the parenthesized person as an affected-person dative in the right place.",
+      "example_html": "<i>ich / nehmen / noch / ein Stück Kuchen (ich)</i> → <i>Ich nehme mir noch ein Stück Kuchen</i>"
+    },
