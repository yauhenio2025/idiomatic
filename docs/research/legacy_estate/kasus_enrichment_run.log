exec
/bin/bash -lc "node <<'NODE'
const fs = require('fs');
const path = 'idiomatic/grammar/data/course/book_local/de_kasus.enrichment.json';
const srcPath = 'idiomatic/grammar/data/course/book_local/de_kasus.exercises.json';
const out = JSON.parse(fs.readFileSync(path, 'utf8'));
const src = JSON.parse(fs.readFileSync(srcPath, 'utf8'));
const errors = [];
const srcBlocks = new Map(src.blocks.map(b => [b.block, b]));
const outBlocks = out.blocks.map(b => b.block);
const expectedBlocks = src.blocks.map(b => b.block);
if (JSON.stringify(outBlocks) "'!== JSON.stringify(expectedBlocks)) errors.push(`blocks mismatch: ${outBlocks} vs ${expectedBlocks}`);
if (new Set(outBlocks).size !== outBlocks.length) errors.push('"'duplicate blocks');
const expectedIds = src.blocks.flatMap(b => b.exercises.map(e => e.id));
const outIds = out.exercises.map(e => e.id);
if (outIds.length "'!== expectedIds.length) errors.push(`exercise count ${outIds.length} vs ${expectedIds.length}`);
const missing = expectedIds.filter(x => !outIds.includes(x));
const extra = outIds.filter(x => !expectedIds.includes(x));
const duplicates = outIds.filter((x, i) => outIds.indexOf(x) !== i);
if (missing.length) errors.push(`missing: ${missing}`);
if (extra.length) errors.push(`extra: ${extra}`);
if (duplicates.length) errors.push(`duplicates: ${duplicates}`);
const normalize = s => s.replace(/<[''^>]+>/g, '"'').replace(/\\s+/g, ' ').trim();
const tagNames = s => [...s.matchAll(/<\\/?([a-z]+)>/gi)].map(m => m[1].toLowerCase());
for (const b of out.blocks) {
  const source = srcBlocks.get(b.block);
  const corpus = normalize(source.exercises.flatMap(e => [e.instruction, e.prompt, e.solution_html, ...e.alternatives]).filter(Boolean).join(' '));
  for (const [field, allowed] of [['task_html', new Set(['i','b','br'])], ['example_html', new Set(['i','br'])]]) {
    const value = b[field];
    if (value == null) continue;
    for (const tag of tagNames(value)) if ("'!allowed.has(tag)) errors.push(`block ${b.block} ${field}: bad tag ${tag}`);
    for (const m of value.matchAll(/<i>(.*?)<'"\\/i>/g)) {
      const span = normalize(m[1]);
      if ("'!corpus.includes(span)) errors.push(`block ${b.block} ${field}: uncopied i span ${JSON.stringify(span)}`);
    }
  }
  const visible = normalize(b.task_html);
  if (visible.length > 180) errors.push(`block ${b.block} task length ${visible.length}`);
}
for (const e of out.exercises) {
  if (/<'"\\/?(?"'!i'"\\b)["'^>]+>/.test(e.why_en)) errors.push(`${e.id}: disallowed why tag`);
  if (/<[''^>]+>/.test(e.solution_en)) errors.push(`${e.id}: solution_en contains HTML`);
  const sentences = e.why_en.match(/[.!?](?:'"\\s|"'$)/g) || [];
  if (sentences.length !== 1) errors.push(`${e.id}: why sentence punctuation count ${sentences.length}`);
  const visibleWhy = normalize(e.why_en);
  if (visibleWhy.length > 140) errors.push(`${e.id}: why length ${visibleWhy.length}`);
}
console.log(JSON.stringify({
  parsed: true,
  blocks: out.blocks.length,
  exercises: out.exercises.length,
  task_visible_lengths: out.blocks.map(b => [b.block, normalize(b.task_html).length]),
  max_why_visible_length: Math.max(...out.exercises.map(e => normalize(e.why_en).length)),
  errors
}, null, 2));
