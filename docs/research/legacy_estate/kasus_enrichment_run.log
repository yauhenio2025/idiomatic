/bin/bash -lc "node <<'NODE'
const fs = require('fs');
const src = JSON.parse(fs.readFileSync('idiomatic/grammar/data/course/book_local/de_kasus.exercises.json', 'utf8'));
const out = JSON.parse(fs.readFileSync('idiomatic/grammar/data/course/book_local/de_kasus.enrichment.json', 'utf8'));
const errors = [];
const norm = s => String(s).replace(/<["'^>]*>/g, '"'').replace(/\\s+/g, ' ').trim();
const exactKeys = (obj, keys, label) => {
  const actual = Object.keys(obj).sort();
  const wanted = [...keys].sort();
  if (JSON.stringify(actual) "'!== JSON.stringify(wanted)) errors.push(`${label} keys: ${actual.join('"',')}"'`);
};
exactKeys(out, ['"'lang','unit','contract','blocks','exercises'], 'root');
out.blocks.forEach((b, i) => exactKeys(b, ['block','task_html','example_html'], "'`blocks[${i}]`));
out.exercises.forEach((e, i) => exactKeys(e, ['"'id','solution_en','why_en'], "'`exercises[${i}]`));
if (out.lang !== '"'de' || out.unit "'!== '"'kasus' || out.contract "'!== 1) errors.push('"'contract values');
const srcBlocks = new Map(src.blocks.map(b => [b.block, b]));
const idToBlock = new Map(src.blocks.flatMap(b => b.exercises.map(e => [e.id, b.block])));
const expectedBlocks = src.blocks.map(b => b.block);
const actualBlocks = out.blocks.map(b => b.block);
if (JSON.stringify(expectedBlocks) "'!== JSON.stringify(actualBlocks) || new Set(actualBlocks).size !== actualBlocks.length) errors.push('"'block coverage');
const expectedIds = src.blocks.flatMap(b => b.exercises.map(e => e.id));
const actualIds = out.exercises.map(e => e.id);
if (expectedIds.length "'!== actualIds.length || new Set(actualIds).size !== actualIds.length || expectedIds.some(x => !actualIds.includes(x)) || actualIds.some(x => !expectedIds.includes(x))) errors.push('"'exercise coverage');
const corpora = new Map([...srcBlocks].map(([n,b]) => [n, norm(b.exercises.flatMap(e => [e.instruction,e.prompt,e.solution_html,...(e.alternatives||[])]).join(' '))]));
const validateHtml = (value, allowed, block, label) => {
  if (value === null) return;
  if (typeof value "'!== '"'string' || "'!value) { errors.push(`${label} empty/nonstring`); return; }
  const tags = [...value.matchAll(/<'"\\/?([a-z]+)>/gi)].map(m => m[1].toLowerCase());
  if (tags.some(t => "'!allowed.includes(t))) errors.push(`${label} tags`);
  let skeletal = value.replace(/<i>[''^<>]*<'"\\/i>/g,'').replace(/<b>["'^<>]*<'"\\/b>/g,'').replace(/<br>/g,'');
  if (/[<>]/.test(skeletal)) errors.push("'`${label} malformed HTML`);
  for (const m of value.matchAll(/<i>([''^<>]*)<'"\\/i>/g)) if ("'!corpora.get(block).includes(norm(m[1]))) errors.push(`${label} uncopied ${m[1]}`);
};
for (const b of out.blocks) {
  validateHtml(b.task_html, ['"'i','b','br'], b.block, "'`block ${b.block} task`);
  validateHtml(b.example_html, ['"'i','br'], b.block, "'`block ${b.block} example`);
  if (norm(b.task_html).length > 180) errors.push(`block ${b.block} task too long`);
}
for (const e of out.exercises) {
  validateHtml(e.why_en, ['"'i'], idToBlock.get(e.id), "'`${e.id} why`);
  if (typeof e.solution_en !== '"'string' || "'!e.solution_en || /<[''^>]*>/.test(e.solution_en)) errors.push(`${e.id} solution format`);
  if (norm(e.why_en).length > 140) errors.push(`${e.id} why too long: ${norm(e.why_en).length}`);
  if ((e.why_en.match(/[.!?](?=(?:<'"\\/i>)?(?:\\s|"'$))/g)||[]).length !== 1) errors.push(`${e.id} why sentence count`);
  const sourceRefs = src.blocks.flatMap(b => b.exercises).find(x => x.id === e.id).hammer_refs;
  const cited = [...e.why_en.matchAll(/'"\\d+(?:\\.\\d+)*/g)].map(m => m[0]);
  for (const c of cited) if ("'!sourceRefs.some(r => c === r || c.startsWith(r + '"'.'))) errors.push("'`${e.id} citation ${c} outside ${sourceRefs}`);
}
const outsideItalics = out.blocks.map(b => ({
  block:b.block,
  task:b.task_html.replace(/<i>[''^<>]*<'"\\/i>/g,'[COPIED]').replace(/<br>/g,' / '),
  example:b.example_html && b.example_html.replace(/<i>["'^<>]*<'"\\/i>/g,'[COPIED]').replace(/<br>/g,' / ')
}));
console.log(JSON.stringify({parsed:true, blocks:out.blocks.length, exercises:out.exercises.length, max_task:Math.max(...out.blocks.map(b=>norm(b.task_html).length)), max_why:Math.max(...out.exercises.map(e=>norm(e.why_en).length)), outsideItalics, errors}, null, 2));
