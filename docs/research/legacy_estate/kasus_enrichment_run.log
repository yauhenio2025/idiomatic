+  "blocks": [
+    {
+      "block": 3,
+      "task_html": "Make two requests with <i>Ich möchte …</i> plus a direct object: first with a definite article, then with an indefinite article—or none in the plural.",
+      "example_html": "<i>klein / Mineralwasser</i> → <i>Ich möchte das kleine Mineralwasser.</i><br><i>Ich möchte ein kleines Mineralwasser</i>"
+    },
+    {
+      "block": 4,
+      "task_html": "Put each bracketed time, distance, or measurement phrase in the correct case. Omit the definite article where required.",
+      "example_html": null
+    },
+    {
+      "block": 5,
+      "task_html": "Build a complete sentence from each cue, conjugating the bracketed verb. Add any needed pronouns or determiners and include a dative.",
+      "example_html": null
+    },
+    {
+      "block": 6,
+      "task_html": "Build an idiomatic sentence in an appropriate tense. Insert the parenthesized person as an affected-person dative in the right place.",
+      "example_html": "<i>ich / nehmen / noch / ein Stück Kuchen (ich)</i> → <i>Ich nehme mir noch ein Stück Kuchen</i>"
+    },
+    {
+      "block": 8,
+      "task_html": "Link the cues into one noun phrase, using the genitive or a <i>von</i>-phrase as appropriate and adding articles. Give both when both are idiomatic.",
+      "example_html": "<i>Bau / Kraftwerke</i> → <i>der Bau von Kraftwerken</i><br><i>Bau / unser Haus</i> → <i>der Bau unseres Hauses</i>"
+    },
+    {
+      "block": 9,
+      "task_html": "Complete each apposition by adding the missing article and endings where needed.",
+      "example_html": null
+    },
+    {
+      "block": 10,
+      "task_html": "Complete each sentence with an idiomatic measurement phrase. Count how many permit an acceptable alternative.",
+      "example_html": "<i>Sie brachte mir eine Tasse / heiß / Tee.</i> → <i>Sie brachte mir eine Tasse heißen Tee</i>"
+    }
+  ],
+  "exercises": [
