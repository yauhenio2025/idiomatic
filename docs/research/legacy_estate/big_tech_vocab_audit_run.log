/bin/bash -lc ".venv/bin/python - <<'PY'
import glob,json,os
out='idiomatic/grammar/data/exercises2/batches/output'
for nf in sorted(glob.glob(out+'/*_big_tech_vocab_b0[1-4]_notes.json')):
    base=nf[:-11]
    tf=base+'_triage.json'; inf=base.replace('/output/','/input/')+'.json'
    n=json.load(open(nf)); t=json.load(open(tf)); i=json.load(open(inf))
