+import json
+import math
+import re
+import statistics
+import unicodedata
+from collections import Counter, defaultdict
+from datetime import datetime, timezone
+from pathlib import Path
+
+ROOT = Path('/home/admin/projects/idiomatic')
+LINGQ = ROOT / 'docs/research/lingq/data/lingq_terms.json'
+EXPR = ROOT / 'docs/research/lingq/data/expressions.json'
+NOTES = ROOT / 'idiomatic/grammar/data/exercises2/notes'
+
+terms = json.loads(LINGQ.read_text(encoding='utf-8'))
+expr = json.loads(EXPR.read_text(encoding='utf-8'))
+
+print('languages', Counter(x['lang'] for x in terms))
+print('expressions languages', Counter(x['lang'] for x in expr))
+print('status', Counter(x['status'] for x in terms))
+print('extended_status', Counter(str(x['extended_status']) for x in terms))
+print('status_x_extended')
+for lang in sorted({x['lang'] for x in terms}):
+    print(lang, sorted(Counter((x['status'], x['extended_status']) for x in terms if x['lang'] == lang).items(), key=lambda z:(z[0][0], str(z[0][1]))))
+
+def dt(s):
+    return datetime.fromisoformat(s.replace('Z', '+00:00')) if s else None
+
+asof = datetime.now(timezone.utc)
+print('asof', asof.isoformat())
+print('due behavior by status_x_extended')
+for key, rows in sorted(defaultdict(list, {k: [x for x in terms if (x['status'], x['extended_status']) == k] for k in set((x['status'], x['extended_status']) for x in terms)}).items(), key=lambda z:(z[0][0], str(z[0][1]))):
+    due = [dt(x['srs_due_date']) for x in rows]
+    upd = [dt(x['updated_at']) for x in rows if x['updated_at']]
+    null = sum(v is None for v in due)
+    past = sum(v is not None and v < asof for v in due)
+    future = sum(v is not None and v >= asof for v in due)
+    delta_days = [(v-asof).total_seconds()/86400 for v in due if v]
+    print(key, 'n', len(rows), 'due(null,past,future)', (null,past,future), 'due_delta_median_days', round(statistics.median(delta_days),1) if delta_days else None, 'updated_max', max(upd).isoformat() if upd else None)
+
+print('hint types', Counter(type(x['hints']).__name__ for x in terms))
+hint_entries = []
+for x in terms:
+    h = x['hints']
+    if isinstance(h, list): hint_entries.extend(h)
+    elif isinstance(h, dict): hint_entries.append(h)
+print('hint entry keys', Counter(tuple(sorted(h)) if isinstance(h,dict) else type(h).__name__ for h in hint_entries).most_common(10))
+print('hint locales', Counter((h.get('language') or h.get('locale') or h.get('lang') or '<missing>') for h in hint_entries if isinstance(h,dict)).most_common(30))
+print('sanitized hint samples', [{k:(type(v).__name__ if k not in ('language','locale','lang') else v) for k,v in h.items()} for h in hint_entries[:5] if isinstance(h,dict)])
+
+print('tag container types', Counter(type(x['tags']).__name__ for x in terms))
+alltags=[]
+for x in terms:
+    if isinstance(x['tags'], list): alltags.extend(str(t) for t in x['tags'])
+    elif x['tags']: alltags.append(str(x['tags']))
+print('tag top', Counter(alltags).most_common(40))
+print('tag distinct', len(set(alltags)), 'terms tagged', sum(bool(x['tags']) for x in terms))
+
+print('null/empty fields')
+for f in terms[0]:
+    print(f, sum(x.get(f) is None for x in terms), sum(x.get(f) == '' for x in terms))
+
+print('fragment heuristic by lang')
+end_re = re.compile(r'[.!?…][\"”’»）)\]]*\s*$')
+start_re = re.compile(r'^\s*[\"“‘«(\[]*[A-ZÀ-ÖØ-ÞĀ-ŽΑ-ΩА-Я]')
+bad_re = re.compile(r'\ufffd|(?:Ã.|Â.|â€|ðŸ)')
+for lang in sorted({x['lang'] for x in terms}):
+    frags=[x['fragment'].strip() for x in terms if x['lang']==lang and isinstance(x['fragment'],str) and x['fragment'].strip()]
+    print(lang, 'n',len(frags),'endpunct',sum(bool(end_re.search(f)) for f in frags),'startupper',sum(bool(start_re.search(f)) for f in frags),'newline',sum('\n' in f or '\r' in f for f in frags),'replacement_or_mojibake',sum(bool(bad_re.search(f)) for f in frags),'lt20',sum(len(f)<20 for f in frags),'gt500',sum(len(f)>500 for f in frags),'max',max(map(len,frags),default=0))
+
+print('note file shapes')
+for p in sorted(NOTES.glob('*.json')):
+    d=json.loads(p.read_text(encoding='utf-8'))
+    def collect(obj):
+        out=[]
+        if isinstance(obj,dict):
+            if 'tl' in obj: out.append(obj['tl'])
+            for v in obj.values(): out.extend(collect(v))
+        elif isinstance(obj,list):
+            for v in obj: out.extend(collect(v))
+        return out
+    tls=collect(d)
+    print(p.name, type(d).__name__, (len(d) if hasattr(d,'__len__') else None), 'tl_n',len(tls),'tl_types',dict(Counter(type(v).__name__ for v in tls)))
+
+print('term duplicates', len(terms)-len({(x['lang'],x['term']) for x in terms}), 'lower duplicates', len(terms)-len({(x['lang'],unicodedata.normalize('NFC',x['term']).lower()) for x in terms}))
+print('id duplicates', len(terms)-len({x['lingq_id'] for x in terms}))

