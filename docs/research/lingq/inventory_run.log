+
+def dt(s):
+    return datetime.fromisoformat(s.replace('Z', '+00:00')) if s else None
+
+asof = datetime.now(timezone.utc)
+print('asof', asof.isoformat())
+print('due behavior by status_x_extended')
+for key, rows in sorted(defaultdict(list, {k: [x for x in terms if (x['status'], x['extended_status']) == k] for k in set((x['status'], x['extended_status']) for x in terms)}).items(), key=lambda z:(z[0][0], str(z[0][1]))):
+    due = [dt(x['srs_due_date']) for x in rows]
+    upd = [dt(x['updated_at']) for x in rows if x['updated_at']]
+    null = sum(v is None for v in due)
