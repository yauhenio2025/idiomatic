+    dump_json(OUT / 'dormant_expressions' / f'{lang}.json', dormant_document)
+    summary['overlap'][lang] = overlap['languages'][lang]
+
+dump_json(OUT / 'overlap.json', overlap)
+
+for lang in LANGUAGES:
+    rows = [row for row in terms if row['lang'] == lang]
+    learned = [row for row in rows if row['status'] == 3]
+    frags = [row['fragment'].strip() for row in rows if isinstance(row.get('fragment'), str) and row['fragment'].strip()]
+    learned_terms = sorted(set(clean_lower(row['term']) for row in learned))
+    summary['languages'][lang] = {
+        'rows': len(rows),
