+++ b//tmp/validate_lingq_outputs.py
@@ -0,0 +1,124 @@
+import json
+import re
+import unicodedata
+from pathlib import Path
+
+ROOT = Path('/home/admin/projects/idiomatic')
+OUT = ROOT / 'docs/research/lingq'
+LANGS = ['de', 'es', 'fr', 'it', 'pt']
+ARTICLES = {
+    'de': ['der', 'die', 'das', 'den', 'dem', 'des', 'ein', 'eine', 'einen', 'einem', 'einer', 'eines'],
+    'es': ['el', 'la', 'los', 'las', 'un', 'una', 'unos', 'unas'],
+    'fr': ['le', 'la', 'les', 'un', 'une', 'des', "l'", 'l’'],
+    'it': ['il', 'lo', 'la', 'i', 'gli', 'le', 'un', 'uno', 'una', "l'", 'l’', "un'", 'un’'],
+    'pt': ['o', 'a', 'os', 'as', 'um', 'uma', 'uns', 'umas'],
+}
+
+
+def clean(value):
+    return re.sub(r'\s+', ' ', unicodedata.normalize('NFC', value).strip()).lower()
+
+
+def norm(value, lang):
+    value = clean(value)
+    for article in sorted(ARTICLES[lang], key=len, reverse=True):
+        if article.endswith(("'", '’')):
+            if value.startswith(article) and len(value) > len(article):
+                return value[len(article):].lstrip()
+        elif value.startswith(article + ' '):
+            return value[len(article):].lstrip()
+    return value
+
+
+def tls(value):
+    result = []
+    if isinstance(value, dict):
+        if isinstance(value.get('tl'), str):
+            result.append(value['tl'])
+        for child in value.values():
+            result += tls(child)
+    elif isinstance(value, list):
+        for child in value:
+            result += tls(child)
+    return result
+
+
+json_paths = [OUT / 'inventory.json', OUT / 'overlap.json']
+json_paths += [OUT / 'known_lexicons' / f'{lang}.json' for lang in LANGS]
+json_paths += [OUT / 'dormant_expressions' / f'{lang}.json' for lang in LANGS]
+assert len(json_paths) == 12 and all(path.is_file() for path in json_paths)
+for path in json_paths:
+    raw = path.read_bytes()
+    assert raw.endswith(b'\n'), path
+    text = raw.decode('utf-8')
+    parsed = json.loads(text)
+    assert text == json.dumps(parsed, ensure_ascii=False, indent=2) + '\n', path
+
+terms = json.loads((OUT / 'data/lingq_terms.json').read_text(encoding='utf-8'))
+expressions = json.loads((OUT / 'data/expressions.json').read_text(encoding='utf-8'))
+inventory = json.loads((OUT / 'inventory.json').read_text(encoding='utf-8'))
+overlap = json.loads((OUT / 'overlap.json').read_text(encoding='utf-8'))
+assert len(terms) == 51826
+assert len(expressions) == 3140
+assert sum(value['row_count'] for value in inventory['languages'].values()) == len(terms)
+
+for lang, value in inventory['languages'].items():
+    assert sum(value['status_totals'].values()) == value['row_count']
+    assert sum(value['extended_status_totals'].values()) == value['row_count']
+    assert sum(value['fragment'][key] for key in ['non_empty_count', 'empty_or_null_count']) == value['row_count']
+    assert sum(value['srs_due_date'][key]['count'] for key in ['overdue', 'future', 'null']) == value['row_count']
+    for status in ['0', '1', '2', '3']:
+        assert sum(value['status_by_extended_status'][status].values()) == value['status_totals'][status]
+
+for lang in LANGS:
+    rows = [row for row in terms if row['lang'] == lang]
+    learned_rows = [row for row in rows if row['status'] == 3]
+    learned = sorted({clean(row['term']) for row in learned_rows})
+    lex = json.loads((OUT / 'known_lexicons' / f'{lang}.json').read_text(encoding='utf-8'))
+    combined = lex['single_word'] + lex['multi_word']
+    assert all(item == clean(item) for item in combined)
+    assert len(combined) == len(set(combined)) == len(learned)
+    assert lex['single_word'] == sorted(lex['single_word'])
+    assert lex['multi_word'] == sorted(lex['multi_word'])
+    assert all(' ' not in item for item in lex['single_word'])
+    assert all(' ' in item for item in lex['multi_word'])
+    assert set(combined) == set(learned)
+    assert lex['header']['per_tier_counts']['status_3_learned'] == len(learned_rows)
+
+    exercise_keys = set()
+    for path in sorted((ROOT / 'idiomatic/grammar/data/exercises2/notes').glob(f'{lang}_*.json')):
+        exercise_keys |= {norm(value, lang) for value in tls(json.loads(path.read_text(encoding='utf-8'))) if clean(value)}
+    expression_keys = {
+        norm(row['normalized'], lang)
+        for row in expressions
+        if row['lang'] == lang and isinstance(row.get('normalized'), str) and row['normalized'].strip()
+    }
+    dormant_expected = {
+        item for item in learned
+        if ' ' in item and norm(item, lang) not in exercise_keys and norm(item, lang) not in expression_keys
+    }
+    dormant_doc = json.loads((OUT / 'dormant_expressions' / f'{lang}.json').read_text(encoding='utf-8'))
+    dormant = dormant_doc['expressions']
+    assert dormant == sorted(dormant, key=lambda row: (-row['status'], row['term']))
+    assert dormant_doc['header']['count'] == len(dormant)
+    assert len(dormant) == overlap['languages'][lang]['learned_tier']['dormant_multi_word_count']
+    assert {row['term_lower'] for row in dormant} == dormant_expected
+    assert all(row['status'] == 3 and ' ' in row['term_lower'] for row in dormant)
+    assert all(norm(row['term'], lang) not in exercise_keys and norm(row['term'], lang) not in expression_keys for row in dormant)
+
+    learned_info = overlap['languages'][lang]['learned_tier']
+    assert learned_info['in_either_count'] + learned_info['dormant_in_neither_count'] == len(learned)
+    assert learned_info['dormant_single_word_count'] + learned_info['dormant_multi_word_count'] == learned_info['dormant_in_neither_count']
+
+report = (OUT / 'REPORT.md').read_text(encoding='utf-8')
+assert 'lingq_id' not in report
+assert '"fragment"' not in report
+assert '"hints"' not in report
+for expected in ['51,826', '1,593', '1,237', '99.12%', '1,231', '42,399', '23,615']:
+    assert expected in report, expected
+
+print(f'PASS: {len(json_paths)} JSON outputs are exact pretty-printed UTF-8')
+print('PASS: inventory matrices, fragment counts, and SRS splits reconcile')
+print('PASS: 5 known lexicons are learned-tier, lowercased, deduplicated, split, and sorted')
+print('PASS: 5 dormant-expression files re-derive as absent from both corpora and sorted')
+print('PASS: aggregate report contains required headline counts and no row-level field labels')
