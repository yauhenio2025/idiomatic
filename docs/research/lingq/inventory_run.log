+    tag_taxonomy = {}
+    for category in ['part_of_speech', 'grammatical_person', 'inflection_or_grammar', 'source_or_import', 'lexical_or_other']:
+        matching = {tag: count for tag, count in tag_counts.items() if tag_category(tag) == category}
+        tag_taxonomy[category] = {
+            'assignment_count': sum(matching.values()),
