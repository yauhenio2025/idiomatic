+        'fragments_cap_250': sum(len(value) == 250 for value in frags),
+        'fragments_cap_nonterminal': sum(len(value) == 250 and not TERMINAL_RE.search(value) for value in frags),
+        'fragments_cloze_markup': sum('[[[' in value for value in frags),
+    }
+
+summary['global'] = {
+    'status_counts': {str(status): sum(row['status'] == status for row in terms) for status in range(4)},
