+import json
+import re
+import statistics
+import unicodedata
+from collections import Counter
+from datetime import datetime, timezone
+from pathlib import Path
+
+ROOT = Path('/home/admin/projects/idiomatic')
+OUT = ROOT / 'docs/research/lingq'
+TERMS_PATH = OUT / 'data/lingq_terms.json'
+EXPRESSIONS_PATH = OUT / 'data/expressions.json'
+NOTES_DIR = ROOT / 'idiomatic/grammar/data/exercises2/notes'
+LANGUAGES = ['de', 'sv', 'fr', 'nl', 'pt', 'es', 'zh', 'it', 'da', 'no']
+OVERLAP_LANGUAGES = ['de', 'es', 'fr', 'it', 'pt']
+
+ARTICLES = {
+    'de': ['der', 'die', 'das', 'den', 'dem', 'des', 'ein', 'eine', 'einen', 'einem', 'einer', 'eines'],
+    'es': ['el', 'la', 'los', 'las', 'un', 'una', 'unos', 'unas'],
+    'fr': ['le', 'la', 'les', 'un', 'une', 'des', "l'", 'l’'],
+    'it': ['il', 'lo', 'la', 'i', 'gli', 'le', 'un', 'uno', 'una', "l'", 'l’', "un'", 'un’'],
+    'pt': ['o', 'a', 'os', 'as', 'um', 'uma', 'uns', 'umas'],
+}
+
+POS_TAGS = {
+    'noun', 'verb', 'adjective', 'adverb', 'preposition', 'pronoun', 'conjunction',
+    'article', 'determiner', 'numeral', 'interjection', 'auxiliary', 'modal',
+    'verbo', 'verbe', 'substantiv', 'nomen', 'adjektiv', 'adverbio', 'adverbe',
+    'preposición', 'preposição', 'préposition', 'pronombre', 'pronom',
+}
+PERSON_TAGS = {
+    'ich', 'du', 'er/sie/es', 'wir', 'ihr', 'sie/sie', 'je', "j'", 'tu',
+    'il/elle', 'nous', 'vous', 'ils/elles', 'io', 'lei/lui', 'noi', 'voi',
+    'loro', 'yo', 'él/ella/ud.', 'nosotros/as', 'vosotros/as',
+    'ellos/ellas/uds.', 'eu', 'ele/ela/você', 'nós', 'vós', 'eles/elas/vocês',
+}
+GRAMMAR_RE = re.compile(
+    r'(present|presente|présent|präsens|preter|pretérit|präterit|perfect|perfeito|perfecto|'
+    r'passato|passé|imparfait|imperf|futur|future|gerund|gerúnd|gerundio|particip|partizip|'
+    r'indicativ|indikativ|indicativo|subjunct|subjonct|conjuntiv|konjunktiv|condition|condizional|'
+    r'imperativ|impératif|imperativo|infinitiv|infinitif|infinitivo|plus-que|trapassado|'
+    r'progressiv|passiv|passive|reflexiv|reflexive)', re.IGNORECASE
+)
+SOURCE_RE = re.compile(r'(^|[_\s-])(kindle|march\s*2019|mar\s*2019|test|import|lesson|batch)([_\s-]|$)', re.IGNORECASE)
+TERMINAL_RE = re.compile(r'[.!?…。！？][\"”’»）)\]]*\s*$')
+HTML_RE = re.compile(r'<[^>]+>')
+CONTROL_RE = re.compile(r'[\x00-\x08\x0b\x0c\x0e-\x1f]')
+
+
+def dump_json(path, value):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
+
+
+def pct(n, d):
+    return round(100 * n / d, 2) if d else 0.0
+
+
+def parse_dt(value):
+    if not value:
+        return None
+    return datetime.fromisoformat(value.replace('Z', '+00:00'))
+
+
+def clean_lower(value):
+    return re.sub(r'\s+', ' ', unicodedata.normalize('NFC', value).strip()).lower()
+
+
+def match_normalize(value, lang):
+    normalized = clean_lower(value)
+    for article in sorted(ARTICLES.get(lang, []), key=len, reverse=True):
+        if article.endswith(("'", '’')):
+            if normalized.startswith(article) and len(normalized) > len(article):
+                return normalized[len(article):].lstrip()
+        elif normalized.startswith(article + ' '):
+            return normalized[len(article):].lstrip()
+    return normalized
+
+
+def is_multiword(value):
+    return ' ' in re.sub(r'\s+', ' ', value.strip())
+
+
+def tag_category(tag):
+    folded = unicodedata.normalize('NFC', tag).strip().lower()
+    if folded in POS_TAGS:
+        return 'part_of_speech'
+    if folded in PERSON_TAGS:
+        return 'grammatical_person'
+    if GRAMMAR_RE.search(folded):
+        return 'inflection_or_grammar'
+    if SOURCE_RE.search(folded):
+        return 'source_or_import'
+    return 'lexical_or_other'
+
+
+def recursively_collect_tl(value):
+    found = []
+    if isinstance(value, dict):
+        if isinstance(value.get('tl'), str):
+            found.append(value['tl'])
+        for child in value.values():
+            found.extend(recursively_collect_tl(child))
+    elif isinstance(value, list):
+        for child in value:
+            found.extend(recursively_collect_tl(child))
+    return found
+
+
+terms = json.loads(TERMS_PATH.read_text(encoding='utf-8'))
+expressions = json.loads(EXPRESSIONS_PATH.read_text(encoding='utf-8'))
+generated_at = datetime.now(timezone.utc)
+generated_at_text = generated_at.isoformat()
+
+global_matrix = Counter((row['status'], row['extended_status']) for row in terms)
+global_due_matrix = {}
+for status, extended in sorted(global_matrix, key=lambda key: (key[0], str(key[1]))):
+    rows = [row for row in terms if (row['status'], row['extended_status']) == (status, extended)]
+    overdue = sum(parse_dt(row['srs_due_date']) < generated_at for row in rows if row['srs_due_date'])
+    future = sum(parse_dt(row['srs_due_date']) >= generated_at for row in rows if row['srs_due_date'])
+    null = sum(not row['srs_due_date'] for row in rows)
+    global_due_matrix[f'{status}|{"null" if extended is None else extended}'] = {
+        'count': len(rows), 'overdue': overdue, 'future': future, 'null': null,
+    }
+
+inventory = {
+    'schema_version': 1,
+    'generated_at_utc': generated_at_text,
+    'source': {
+        'lingq_terms_path': 'docs/research/lingq/data/lingq_terms.json',
+        'row_count': len(terms),
+        'languages_expected': LANGUAGES,
+    },
+    'definitions': {
+        'non_empty': 'A string with at least one non-whitespace character, or a non-empty JSON list as applicable.',
+        'percentages': 'Percentages are rounded to two decimals.',
+        'srs_due_date_split': f'overdue is earlier than generated_at_utc; future is equal to or later than generated_at_utc ({generated_at_text}).',
+        'learned_tier': 'status == 3. extended_status == 3 is reported separately as the durable-known marker; the lone status 0 / extended_status 3 contradiction is excluded.',
+        'fragment_sentence_terminal_heuristic': 'Non-empty fragment ends in Latin or CJK sentence punctuation, allowing trailing quote/bracket characters.',
+        'fragment_probable_api_truncation': 'Character length is exactly 250 and the fragment does not end in sentence punctuation.',
+        'tag_taxonomy': {
+            'part_of_speech': 'Exact match to a compact multilingual part-of-speech label list.',
+            'grammatical_person': 'Exact match to common conjugation-person labels present in the data.',
+            'inflection_or_grammar': 'Tag contains a multilingual tense, mood, participle, voice, or inflection keyword.',
+            'source_or_import': 'Tag contains an explicit Kindle, date-import, test, lesson, import, or batch marker.',
+            'lexical_or_other': 'All remaining tags; many are lemma-like labels, but the source has no tag type field, so they are not asserted to be lemmas.',
+        },
+    },
+    'account_status_semantics': {
+        'nominal_status_levels': {
+            '0': 'new/unprogressed stored level',
+            '1': 'recognized stored level',
+            '2': 'familiar stored level',
+            '3': 'learned stored level',
+        },
+        'extended_status_levels_observed': {
+            'null': 'legacy or unpopulated extended state; not a known marker',
+            '0': 'explicit ordinary/reviewable extended state; not a known marker',
+            '3': 'durable-known marker when paired with status 3',
+        },
+        'status_by_extended_status_account_counts': {
+            str(status): {
+                key: global_matrix.get((status, ext), 0)
+                for key, ext in [('null', None), ('0', 0), ('3', 3)]
+            }
+            for status in range(4)
+        },
+        'srs_evidence_by_status_extended_status': global_due_matrix,
+        'key_evidence': {
+            'status_3_extended_3_count': global_matrix[(3, 3)],
+            'status_3_extended_3_future_due_count': global_due_matrix['3|3']['future'],
+            'status_3_extended_0_or_null_count': global_matrix[(3, 0)] + global_matrix[(3, None)],
+            'status_3_extended_0_or_null_overdue_count': global_due_matrix['3|0']['overdue'] + global_due_matrix['3|null']['overdue'],
+            'contradictory_status_0_extended_3_count': global_matrix[(0, 3)],
+        },
+        'interpretation': 'In this account, status 3 is the broad learned tier. extended_status 3 isolates a durable-known subset because every consistent status 3 / extended_status 3 row is future-due, while all status 3 rows with extended_status 0 or null are overdue. One status 0 / extended_status 3 row is internally inconsistent and is not used as learned vocabulary.',
+    },
+    'languages': {},
+}
+
+for lang in LANGUAGES:
+    rows = [row for row in terms if row['lang'] == lang]
+    matrix = Counter((row['status'], row['extended_status']) for row in rows)
+    fragments = [row['fragment'].strip() for row in rows if isinstance(row.get('fragment'), str) and row['fragment'].strip()]
+    fragment_lengths = [len(value) for value in fragments]
+    terminal_count = sum(bool(TERMINAL_RE.search(value)) for value in fragments)
+    cap_count = sum(len(value) == 250 for value in fragments)
+    cap_nonterminal_count = sum(len(value) == 250 and not TERMINAL_RE.search(value) for value in fragments)
+    hint_rows = [row for row in rows if isinstance(row.get('hints'), list) and row['hints']]
+    hint_entries = [hint for row in rows for hint in row.get('hints', []) if isinstance(hint, dict)]
+    locale_counts = Counter(hint.get('locale') or '<missing>' for hint in hint_entries)
+    tag_counts = Counter(str(tag) for row in rows for tag in row.get('tags', []))
+    tag_taxonomy = {}
+    for category in ['part_of_speech', 'grammatical_person', 'inflection_or_grammar', 'source_or_import', 'lexical_or_other']:
+        matching = {tag: count for tag, count in tag_counts.items() if tag_category(tag) == category}
+        tag_taxonomy[category] = {
+            'assignment_count': sum(matching.values()),
+            'distinct_tag_count': len(matching),
+            'top_tags': [
+                {'tag': tag, 'count': count}
+                for tag, count in sorted(matching.items(), key=lambda pair: (-pair[1], pair[0].lower()))[:20]
+            ],
+        }
+    due = [parse_dt(row.get('srs_due_date')) for row in rows]
+    overdue = sum(value is not None and value < generated_at for value in due)
+    future = sum(value is not None and value >= generated_at for value in due)
+    null_due = sum(value is None for value in due)
+    inventory['languages'][lang] = {
+        'row_count': len(rows),
+        'status_by_extended_status': {
+            str(status): {
+                key: matrix.get((status, ext), 0)
+                for key, ext in [('null', None), ('0', 0), ('3', 3)]
+            }
+            for status in range(4)
+        },
+        'status_totals': {str(status): sum(row['status'] == status for row in rows) for status in range(4)},
+        'extended_status_totals': {
+            key: sum(row['extended_status'] == ext for row in rows)
+            for key, ext in [('null', None), ('0', 0), ('3', 3)]
+        },
+        'fragment': {
+            'non_empty_count': len(fragments),
+            'non_empty_pct': pct(len(fragments), len(rows)),
+            'empty_or_null_count': len(rows) - len(fragments),
+            'average_char_length_non_empty': round(statistics.mean(fragment_lengths), 2) if fragment_lengths else 0.0,
+            'median_char_length_non_empty': statistics.median(fragment_lengths) if fragment_lengths else 0.0,
+            'distinct_non_empty_count': len(set(fragments)),
+            'sentence_terminal_count': terminal_count,
+            'sentence_terminal_pct_of_non_empty': pct(terminal_count, len(fragments)),
+            'length_exactly_250_count': cap_count,
+            'probable_api_truncation_count': cap_nonterminal_count,
+            'cloze_markup_count': sum('[[[' in value for value in fragments),
+            'html_markup_count': sum(bool(HTML_RE.search(value)) for value in fragments),
+            'unicode_replacement_character_count': sum('\ufffd' in value for value in fragments),
+            'control_character_count': sum(bool(CONTROL_RE.search(value)) for value in fragments),
+        },
+        'hints': {
+            'terms_with_non_empty_hints_count': len(hint_rows),
+            'terms_with_non_empty_hints_pct': pct(len(hint_rows), len(rows)),
+            'total_hint_records': len(hint_entries),
+            'terms_with_multiple_hints_count': sum(len(row.get('hints', [])) > 1 for row in rows),
+            'dominant_locales': [
+                {'locale': locale, 'count': count, 'pct_of_hint_records': pct(count, len(hint_entries))}
+                for locale, count in locale_counts.most_common()
+            ],
+        },
+        'tags': {
+            'terms_with_tags_count': sum(bool(row.get('tags')) for row in rows),
+            'terms_with_tags_pct': pct(sum(bool(row.get('tags')) for row in rows), len(rows)),
+            'total_tag_assignments': sum(tag_counts.values()),
+            'distinct_tag_count': len(tag_counts),
+            'singleton_tag_count': sum(count == 1 for count in tag_counts.values()),
+            'distinct_tag_frequency_histogram': {
+                str(frequency): count
+                for frequency, count in sorted(Counter(tag_counts.values()).items())
+            },
+            'taxonomy': tag_taxonomy,
+        },
+        'srs_due_date': {
+            'as_of_utc': generated_at_text,
+            'overdue': {'count': overdue, 'pct': pct(overdue, len(rows))},
+            'future': {'count': future, 'pct': pct(future, len(rows))},
+            'null': {'count': null_due, 'pct': pct(null_due, len(rows))},
+        },
+        'max_updated_at': max(row['updated_at'] for row in rows),
+    }
+
+dump_json(OUT / 'inventory.json', inventory)
+
+normalization_description = {
+    'steps_in_order': [
+        'Normalize Unicode to NFC.',
+        'Trim leading/trailing whitespace and collapse every internal whitespace run to one ASCII space.',
+        'Lowercase with Python str.lower(); accents and diacritics are preserved.',
+        'Strip at most one language-specific leading article. Standalone articles require a following space; apostrophized French/Italian articles are removed without requiring a space.',
+        'Perform exact string equality after these steps. No stemming, lemmatization, punctuation removal, accent folding, hyphen folding, or fuzzy matching is used.',
+    ],
+    'leading_articles_by_language': ARTICLES,
+    'multi_word_definition': 'The lowercased, whitespace-collapsed LingQ term contains an ASCII space; hyphenated and apostrophized forms without a space count as single-word.',
+    'counting_basis': 'Overlap and dormant counts use lowercased, whitespace-collapsed, deduplicated LingQ term strings as the left-hand entries. Matching uses the article-stripped normalization; more than one LingQ entry may therefore share a match key.',
+}
+
+overlap = {
+    'schema_version': 1,
+    'generated_at_utc': generated_at_text,
+    'sources': {
+        'lingq_terms_path': 'docs/research/lingq/data/lingq_terms.json',
+        'expressions_path': 'docs/research/lingq/data/expressions.json',
+        'exercises2_glob': 'idiomatic/grammar/data/exercises2/notes/<lang>_*.json',
+        'exercises2_field': 'Every string-valued tl field found recursively in each matched JSON file.',
+    },
+    'normalization': normalization_description,
+    'learned_tier_definition': 'status == 3; extended_status == 3 is a durable-known subset, not a replacement for nominal learned status. The lone status 0 / extended_status 3 contradiction is excluded.',
+    'languages': {},
+}
+
+summary = {
+    'generated_at_utc': generated_at_text,
+    'total_rows': len(terms),
+    'languages': {},
+    'overlap': {},
+}
+
+for lang in OVERLAP_LANGUAGES:
+    rows = [row for row in terms if row['lang'] == lang]
+    lingq_entries = sorted(set(clean_lower(row['term']) for row in rows))
+    lingq_keys = {match_normalize(term, lang) for term in lingq_entries}
+    note_files = sorted(NOTES_DIR.glob(f'{lang}_*.json'))
+    note_tls = []
+    note_top_level_items = 0
+    for path in note_files:
+        data = json.loads(path.read_text(encoding='utf-8'))
+        note_top_level_items += len(data) if isinstance(data, list) else 1
+        note_tls.extend(recursively_collect_tl(data))
+    exercise_keys = {match_normalize(value, lang) for value in note_tls if clean_lower(value)}
+    lang_expressions = [row for row in expressions if row['lang'] == lang]
+    expression_values = [row['normalized'] for row in lang_expressions if isinstance(row.get('normalized'), str) and row['normalized'].strip()]
+    expression_keys = {match_normalize(value, lang) for value in expression_values}
+    known_rows = [row for row in rows if row['status'] == 3]
+    known_by_lower = {}
+    for row in sorted(known_rows, key=lambda item: (item['lingq_id'])):
+        known_by_lower.setdefault(clean_lower(row['term']), row)
+    known_entries = sorted(known_by_lower)
+
+    def matches_exercise(term):
+        return match_normalize(term, lang) in exercise_keys
+
+    def matches_expression(term):
+        return match_normalize(term, lang) in expression_keys
+
+    lingq_overlap_exercise = sum(matches_exercise(term) for term in lingq_entries)
+    lingq_overlap_expression = sum(matches_expression(term) for term in lingq_entries)
+    lingq_overlap_both = sum(matches_exercise(term) and matches_expression(term) for term in lingq_entries)
+    known_exercise = sum(matches_exercise(term) for term in known_entries)
+    known_expression = sum(matches_expression(term) for term in known_entries)
+    known_both = sum(matches_exercise(term) and matches_expression(term) for term in known_entries)
+    dormant = [term for term in known_entries if not matches_exercise(term) and not matches_expression(term)]
+    dormant_single = [term for term in dormant if not is_multiword(term)]
+    dormant_multi = [term for term in dormant if is_multiword(term)]
+    status3_ext3 = sum(row['status'] == 3 and row['extended_status'] == 3 for row in rows)
+    status3_ext0 = sum(row['status'] == 3 and row['extended_status'] == 0 for row in rows)
+    status3_extnull = sum(row['status'] == 3 and row['extended_status'] is None for row in rows)
+
+    overlap['languages'][lang] = {
+        'lingq': {
+            'raw_row_count': len(rows),
+            'deduplicated_lowercase_term_count': len(lingq_entries),
+            'distinct_match_key_count': len(lingq_keys),
+            'match_key_collisions_from_article_stripping_count': len(lingq_entries) - len(lingq_keys),
+        },
+        'exercises2': {
+            'file_count': len(note_files),
+            'files': [str(path.relative_to(ROOT)) for path in note_files],
+            'top_level_item_count': note_top_level_items,
+            'string_tl_field_count': len(note_tls),
+            'distinct_normalized_headword_count': len(exercise_keys),
+        },
+        'expressions': {
+            'row_count': len(lang_expressions),
+            'non_empty_normalized_count': len(expression_values),
+            'distinct_normalized_count': len(expression_keys),
+        },
+        'all_lingq_term_overlap': {
+            'in_exercises2_count': lingq_overlap_exercise,
+            'in_exercises2_pct': pct(lingq_overlap_exercise, len(lingq_entries)),
+            'in_expressions_count': lingq_overlap_expression,
+            'in_expressions_pct': pct(lingq_overlap_expression, len(lingq_entries)),
+            'in_both_count': lingq_overlap_both,
+            'in_either_count': lingq_overlap_exercise + lingq_overlap_expression - lingq_overlap_both,
+            'in_neither_count': len(lingq_entries) - (lingq_overlap_exercise + lingq_overlap_expression - lingq_overlap_both),
+        },
+        'learned_tier': {
+            'status_3_raw_row_count': len(known_rows),
+            'status_3_extended_3_durable_known_count': status3_ext3,
+            'status_3_extended_0_reviewable_count': status3_ext0,
+            'status_3_extended_null_legacy_count': status3_extnull,
+            'deduplicated_lowercase_term_count': len(known_entries),
+            'in_exercises2_count': known_exercise,
+            'in_expressions_count': known_expression,
+            'in_both_count': known_both,
+            'in_either_count': known_exercise + known_expression - known_both,
+            'dormant_in_neither_count': len(dormant),
+            'dormant_in_neither_pct': pct(len(dormant), len(known_entries)),
+            'dormant_single_word_count': len(dormant_single),
+            'dormant_multi_word_count': len(dormant_multi),
+        },
+    }
+
+    lexicon = {
+        'header': {
+            'language': lang,
+            'source': 'docs/research/lingq/data/lingq_terms.json',
+            'tier_definition': 'status == 3 (learned); extended_status == 3 is the durable-known subset.',
+            'normalization': 'Unicode NFC; trim and collapse whitespace; lowercase with Python str.lower(); deduplicate exact resulting strings. Leading articles are retained in this lexicon.',
+            'per_tier_counts': {
+                'all_lingq_rows': len(rows),
+                'status_0_new': sum(row['status'] == 0 for row in rows),
+                'status_1_recognized': sum(row['status'] == 1 for row in rows),
+                'status_2_familiar': sum(row['status'] == 2 for row in rows),
+                'status_3_learned': len(known_rows),
+                'status_3_extended_3_durable_known': status3_ext3,
+                'status_3_extended_0_reviewable': status3_ext0,
+                'status_3_extended_null_legacy': status3_extnull,
+            },
+            'deduplicated_entry_counts': {
+                'total': len(known_entries),
+                'single_word': sum(not is_multiword(term) for term in known_entries),
+                'multi_word': sum(is_multiword(term) for term in known_entries),
+            },
+        },
